# Antigravity Server Environment Configuration

# Web UI listening port on host
AGY_PORT=8765

# Access password for Web UI (leave empty to let the server generate a random secure password)
AGY_PASSWORD=

# Public domain URL (e.g. https://agy.example.com)
AGY_PUBLIC_URL=

# Trusted reverse proxies CIDRs (e.g. 127.0.0.1/32 or 10.0.0.0/8)
AGY_TRUSTED_PROXIES=

# Optional user & group ID for host volume file ownership
PUID=0
PGID=0
